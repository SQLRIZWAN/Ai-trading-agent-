rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Public read: market data & signals ──────────────────────────────────
    match /market_data/{document=**} {
      allow read: if true;
      allow write: if false;  // Only GitHub Actions service account writes
    }

    match /signals/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /sentiment/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /onchain_data/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // ── System / health ──────────────────────────────────────────────────────
    match /system/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /logs/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── User-specific: users must only access their own data ─────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /portfolio/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /portfolio/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /demo_accounts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /demo_accounts/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /trades/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /trades/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Health ping (for health_check.py) ────────────────────────────────────
    match /_health/{document=**} {
      allow read, write: if false;  // Service account only
    }

    // ── Deny everything else ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
